# macOS Finder metadata. Created in any folder Finder opens, never useful in
# the repo, and this one is public.
.DS_Store

# Local setup for the karaoke harness, per tools/README-selfcheck.md:
#   npm i onnxruntime-node        -> node_modules/ + package*.json
#   Kokoro model files            -> ./m/<repo>/   (hundreds of MB)
# All machine-local. The manifests are ignored too: Aloud ships as one file
# with no build step and no bundler, and a package.json in the root would
# advertise a toolchain that does not exist. onnxruntime-node is a harness
# dependency only — nothing the app loads. If a real build step ever lands,
# delete these two lines rather than working around them.
node_modules/
package.json
package-lock.json
m/

# The editable Swift Playgrounds package must not contain the 327 MB model:
# loading a document that large can terminate the Playgrounds editor. The app
# downloads the pinned model on first use and verifies its exact size/hash.
# Keep any local validation copy ignored as well as excluded by Package.swift.
ios/Aloud.swiftpm/NativeKokoroAssets/kokoro-v1_0.safetensors
