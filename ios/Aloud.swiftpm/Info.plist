<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lock-screen and background playback. Without this the app goes silent
	     the moment the screen turns off, which is most of the point of a
	     read-aloud app. Pairs with AVAudioSession .playback in AudioSession.swift. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- The web app loads kokoro-js from jsDelivr and the Kokoro weights from
	     HuggingFace over HTTPS. Those are ordinary secure loads and need no
	     exception.

	     NSAllowsLocalNetworking covers 127.0.0.1 only: the app serves its own
	     bundled copy of index.html from a loopback HTTP server so the page gets
	     a real HTTP origin (IndexedDB for the library, Cache Storage for the
	     Kokoro weights — neither works on a file:// origin). Loopback traffic
	     never leaves the device. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Lets you drop PDFs/EPUBs into the app's folder from the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
