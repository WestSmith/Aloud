<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lock-screen and background playback. Without this the app goes silent
	     the moment the screen turns off, which is most of the point of a
	     read-aloud app. Pairs with AVAudioSession .playback in AudioSession.swift. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Native Kokoro downloads its pinned full-quality model over HTTPS on
	     first use, verifies its exact size and SHA-256, and retains it in
	     Application Support. HTTPS needs no ATS exception.

	     NSAllowsLocalNetworking covers 127.0.0.1 only: the app serves its own
	     bundled reader and short-lived native Kokoro WAV files from a loopback
	     HTTP server. Loopback traffic never leaves the device. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Lets you drop PDFs/EPUBs into the app's folder from the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
